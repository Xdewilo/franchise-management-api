# Copia este archivo a `.env` y ajusta los valores.
# `.env` está en .gitignore: nunca subas credenciales reales al repositorio.

# --- PostgreSQL -------------------------------------------------------------
# Para desarrollo local con docker compose, estos valores funcionan tal cual.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=franchises
POSTGRES_USER=franchise
POSTGRES_PASSWORD=franchise

# --- Perfil activo ----------------------------------------------------------
SPRING_PROFILES_ACTIVE=local
