# Copia este archivo a `terraform.tfvars` y completa la API key.
# `terraform.tfvars` está en .gitignore: nunca subas credenciales al repositorio.
#
# La API key se genera en:
#   https://console.neon.tech/app/settings/api-keys

neon_api_key = "napi_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Opcionales — descomenta para sobrescribir los valores por defecto.
# project_name  = "franchise-management-api"
# region        = "aws-us-east-1"
# database_name = "franchises"
